@page "{id:int}"
@model EditarModel
@{
    ViewData["Title"] = "Editar tarefa";
}
<div class="pagina-formulario">
    <a asp-page="/Quadro" class="link-secondary">Voltar ao quadro</a>
    <h1 class="mt-3 mb-4">Editar tarefa</h1>
    <form method="post">
        <partial name="_Formulario" model="Model.Tarefa" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a asp-page="/Quadro" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>