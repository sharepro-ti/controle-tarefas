@page "{id:int}"
@model ExcluirModel
@{
    ViewData["Title"] = "Excluir tarefa";
}
<div class="pagina-formulario">
    <a asp-page="/Quadro" class="link-secondary">Voltar ao quadro</a>
    <h1 class="mt-3 mb-4">Excluir tarefa</h1>
    <p>Deseja excluir esta tarefa? Esta ação não pode ser desfeita.</p>
    <dl class="detalhes-tarefa">
        <dt>Título</dt>
        <dd>@Model.Tarefa.Titulo</dd>
        <dt>Descrição</dt>
        <dd class="descricao-completa">@Model.Tarefa.Descricao</dd>
        <dt>Data</dt>
        <dd>@Model.Tarefa.Data.ToString("dd/MM/yyyy")</dd>
    </dl>
    <form method="post" class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
        <a asp-page="/Quadro" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>